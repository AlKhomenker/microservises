{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuditLogs": "Data Source=audit-logs.db"
  },
  "Modules": {
    "AuditLogs": {
      "Database": {
        "ApplyMigrationsOnStartup": false
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
